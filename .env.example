# --- Auth (built against and tested with pocket-id; other OIDC providers are untested) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Whoever first signs in with this email becomes the permanent admin -
# that account can never be disabled, even by another admin. Set it to
# your own address.
ALLOWED_EMAIL=

# Optional - which OIDC "groups" claim value also grants admin, besides
# ALLOWED_EMAIL above. Defaults to "admin" if unset.
# OIDC_ADMIN_GROUP=admin

# Comma-separated hostnames this app answers for.
ALLOWED_HOSTS=tally.example.com

# Seals every account's own encryption key - generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Bearer token for the machine API (API.md) - any long random string.
TALLY_API_TOKEN=

# Where GoCardless redirects back to after a bank's consent step.
# The GoCardless credentials themselves are set in-app: Settings > Admin.
GOCARDLESS_REDIRECT_URL=https://tally.example.com/settings/bank-sync-callback

# --- Storage (defaults shown - uncomment to override) ---
# DATABASE_PATH=./config/tally.db
# USERS_DB_DIR=./config/users
# SYSTEM_DB_PATH=./config/system.db

# --- Automatic scheduled backups (optional) ---
# BACKUP_DIR=./config/backups
# BACKUP_PASSWORD=
# APP_TIMEZONE=Europe/London

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tally",
  "version": "0.1.0",
  "identifier": "com.tally.desktop",
  "build": {
    "frontendDist": "./frontend",
    "beforeBuildCommand": "npm run build && node scripts/stage-desktop.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQTgwODBENEIxQ0EyMjkKUldRcG9oeExEUWlvZ002Z2d0ZTJlaExPbGcrbzliS3RTMVdhbUFHdW5teERRK0g3WUZuMk5lTDgK",
      "endpoints": [
        "https://github.com/tinkermesomething/tally/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
